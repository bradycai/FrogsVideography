{
  "name": "frogs-videography",
  "version": "1.0.0",
  "description": "Marketing website for Frogs Videography — a Massachusetts & Rhode Island video production company.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "vite preview --outDir dist --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{astro,ts,js,css,md,json}\"",
    "db:setup": "node scripts/db-setup.mjs",
    "secrets:key": "node scripts/secrets.mjs key",
    "secrets:password": "node scripts/secrets.mjs password"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.11",
    "astro": "^7.4.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
