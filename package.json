{
  "name": "frogs-videography",
  "version": "1.0.0",
  "description": "Marketing website for Frogs Videography — a Massachusetts & Rhode Island video production company.",
  "type": "module",
  "engines": {
    "node": ">=18.14.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "vite preview --outDir dist --port 4321",
    "check": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "format": "prettier --write \"**/*.{astro,ts,js,css,md,json}\"",
    "db:setup": "node scripts/db-setup.mjs",
    "secrets:key": "node scripts/secrets.mjs key",
    "secrets:password": "node scripts/secrets.mjs password"
  },
  "dependencies": {
    "@astrojs/netlify": "6.6.5",
    "astro": "^5.7.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.2"
  }
}
