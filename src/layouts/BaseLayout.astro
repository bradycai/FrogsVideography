---
import '../styles/global.css';
import { SITE, BUSINESS, LINKS } from '../config/site';

interface Props {
  /** Optional per-page overrides; defaults come from the central config. */
  title?: string;
  description?: string;
  /** Path (relative to site root) for the canonical URL. */
  path?: string;
}

const { title = SITE.title, description = SITE.description, path = '/' } = Astro.props;
const canonical = new URL(path, SITE.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoProductionCompany',
  name: BUSINESS.name,
  description: SITE.description,
  url: SITE.url + '/',
  image: SITE.ogImage,
  priceRange: '$$$',
  areaServed: BUSINESS.areaServed.map((name) => ({ '@type': 'State', name })),
  knowsAbout: [
    'Brand Storytelling',
    'Mini Documentaries',
    'Event Recaps',
    'Commercials',
    'Fundraising Videos',
    'Social Media Videos',
    'Drone Storytelling',
    'Corporate Storytelling',
  ],
  founder: BUSINESS.founders.map((name) => ({ '@type': 'Person', name })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: BUSINESS.rating.value,
    reviewCount: BUSINESS.rating.count,
  },
  ...(BUSINESS.email ? { email: BUSINESS.email } : {}),
  ...(BUSINESS.phone ? { telephone: BUSINESS.phone } : {}),
  sameAs: Object.values(LINKS.social).filter(Boolean),
  potentialAction: {
    '@type': 'ReserveAction',
    target: LINKS.calendly,
    name: 'Book Your Consultation',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={SITE.themeColor} />

    <!-- ============================ SEO ============================ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.keywords.join(', ')} />
    <meta name="author" content={BUSINESS.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <!-- ============================ Icons ========================= -->
    <link rel="icon" type="image/png" href="/images/logo.png?v=2" />
    <link rel="apple-touch-icon" href="/images/logo.png?v=2" />

    <!-- ====================== Open Graph ====================== -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={SITE.ogImage} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />

    <!-- ====================== Twitter ====================== -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE.ogImage} />

    <!-- ====================== Fonts (Clean Swiss sans) ====================== -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="preconnect" href="https://www.youtube.com" />

    <!-- ====================== Schema.org ====================== -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body class="loading">
    <slot />
  </body>
</html>
