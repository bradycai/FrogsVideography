---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS } from '../config/sections';

import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Trust from '../components/Trust.astro';
import Why from '../components/Why.astro';
import Unique from '../components/Unique.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import Reels from '../components/Reels.astro';
import About from '../components/About.astro';
import Roi from '../components/Roi.astro';
import Contact from '../components/Contact.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---

<BaseLayout>
  <div id="progress" aria-hidden="true"></div>

  {SECTIONS.loader && <Loader />}
  {SECTIONS.nav && <Nav />}
  {SECTIONS.nav && <MobileMenu />}

  <main id="top">
    {SECTIONS.hero && <Hero />}
    {SECTIONS.marquee && <Marquee />}
    {SECTIONS.trust && <Trust />}
    {SECTIONS.why && <Why />}
    {SECTIONS.unique && <Unique />}
    {SECTIONS.process && <Process />}
    {SECTIONS.services && <Services />}
    {SECTIONS.portfolio && <Portfolio />}
    {SECTIONS.reels && <Reels />}
    {SECTIONS.about && <About />}
    {SECTIONS.roi && <Roi />}
    {SECTIONS.contact && <Contact />}
    {SECTIONS.finalCta && <FinalCta />}
  </main>

  {SECTIONS.footer && <Footer />}
  {SECTIONS.stickyCta && <StickyCta />}

  <script>
    import '../scripts/main.js';
    import '../scripts/contact.js';
  </script>
</BaseLayout>
