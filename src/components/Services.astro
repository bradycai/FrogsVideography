---
import { SERVICES } from '../config/site';
---

<section id="services" aria-label="Services">
  <div class="wrap">
    <div class="reveal" style="max-width:680px">
      <span class="eyebrow">{SERVICES.eyebrow}</span>
      <h2 class="h-lg">{SERVICES.headingLead} <span class="green">{SERVICES.headingAccent}</span></h2>
      <p class="lead muted" style="margin-top:20px">{SERVICES.body}</p>
    </div>
    <div class="svc-list reveal d1">
      {
        SERVICES.items.map((s, i) => (
          <a class="svc" href={SERVICES.cta.href} target="_blank" rel="noopener">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <p class="out">{s.body}</p>
            </div>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
    <div class="reveal d2" style="margin-top:44px">
      <a class="btn btn-primary" href={SERVICES.cta.href} target="_blank" rel="noopener">
        {SERVICES.cta.label} <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>
