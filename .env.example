# Copy to .env for local development (never commit .env).
# In production, set these in Netlify → Site configuration → Environment variables.

# Postgres connection string (Neon, Supabase, or local). Netlify DB sets
# NETLIFY_DATABASE_URL automatically instead; either one works.
DATABASE_URL=postgres://user:password@localhost:5432/frogs_inquiries

# npm run secrets:key — generate ONCE and keep a copy. Losing it makes stored
# inquiries unreadable.
DATA_ENCRYPTION_KEY=

# npm run secrets:password — the hash of the /admin password (not the password itself).
ADMIN_PASSWORD_HASH=
